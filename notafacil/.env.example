# Token de HOMOLOGAÇÃO da Focus NFe (Painel API → Tokens → Token de homologação).
# Vazio = modo demonstração: a nota não sai da máquina.
FOCUS_NFE_TOKEN=

# Token PRINCIPAL de produção, só para cadastrar empresas e o certificado A1.
# A API de empresas da Focus não existe em homologação. A emissão continua em homologação.
# Deixe vazio para cadastrar o certificado manualmente no painel.
FOCUS_NFE_TOKEN_PRINCIPAL=

# 1 envia o certificado de verdade. Sem isso, o cadastro na Focus é só simulado (dry_run=1).
FOCUS_EMPRESAS_EFETIVAR=0

# Segredo que a Focus envia no header Authorization do webhook. Sem ele o webhook recusa a chamada.
FOCUS_WEBHOOK_SECRET=

# Aberto no primeiro uso local. Em um servidor exposto, use fechado.
NOTAFACIL_REGISTRO=aberto

# Porta do servidor local.
PORT=3000

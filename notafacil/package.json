{
  "name": "notafacil",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' tsx watch src/server/index.ts",
    "start": "NODE_ENV=production NODE_OPTIONS='--experimental-sqlite' tsx src/server/index.ts",
    "build": "vite build",
    "test": "NODE_OPTIONS='--experimental-sqlite' vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
